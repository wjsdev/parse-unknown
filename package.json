{
  "name": "parse-unknown",
  "version": "0.2.0",
  "description": "Parse unknown into types with no assertions",
  "keywords": [
    "parse",
    "parser",
    "unknown",
    "typescript",
    "types",
    "runtime",
    "validation",
    "schema",
    "zod"
  ],
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wjsdev/parse-unknown.git"
  },
  "homepage": "https://github.com/wjsdev/parse-unknown#readme",
  "bugs": "https://github.com/wjsdev/parse-unknown/issues",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "tsdown",
    "tc": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  }
}
